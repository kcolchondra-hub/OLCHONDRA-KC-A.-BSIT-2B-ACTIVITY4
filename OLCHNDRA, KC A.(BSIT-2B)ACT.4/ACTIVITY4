class Person:
    def __init__(self, fname, lname, age, program):
        self.fname = fname
        self.lname = lname
        self.age = age
        self.program = program


def quick_sort(arr):
    if len(arr) <= 1:
        return arr

    pivot = arr[0]
    left = []
    right = []

    for item in arr[1:]:
        if item.lower() <= pivot.lower():
            left.append(item)
        else:
            right.append(item)
            

    return quick_sort(left) + [pivot] + quick_sort(right)

def quick_sort_people(arr, choice):
    if len(arr) <= 1:
        return arr

    pivot = arr[0]
    left = []
    right = []

    for person in arr[1:]:

        if choice == "1":
            value = person.age
            pivot_value = pivot.age

        elif choice == "2":
            value = person.fname.lower()
            pivot_value = pivot.fname.lower()

        elif choice == "3":
            value = person.lname.lower()
            pivot_value = pivot.lname.lower()

        else:
            value = person.program.lower()
            pivot_value = pivot.program.lower()

        if value <= pivot_value:
            left.append(person)
        else:
            right.append(person)

    return quick_sort_people(left, choice) + [pivot] + quick_sort_people(right, choice)


names = ["Kira", "Kc", "Blaise", "Angel", "Kendra"]

print("Original Names:")
print(names)

print("\nSorted Names:")
print(quick_sort(names))


